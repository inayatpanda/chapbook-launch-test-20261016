---
import {site} from '../../lib/site';
import {professionalDetails,contactHref} from '../../lib/professional.mjs';
import {withBase} from '../../lib/withBase';
import ServiceMenu from '../professional/ServiceMenu.astro';
import PracticeNotes from '../professional/PracticeNotes.astro';
const p=professionalDetails((site as any).professional);
const {name,masthead,tagline,posts,postsHref,aboutHref}=Astro.props;
const cta=p.bookingUrl?withBase('/appointments/'):contactHref(p);
---
<section class="pro-site contour"><section class="contour-opening"><div><p class="pro-kicker">{p.eyebrow||name}</p><h1>{p.heading||masthead}</h1><p class="pro-intro">{p.intro||tagline}</p></div><aside><span class="pro-number">Start here</span><h2>A consultation,<br/>at your pace.</h2>{p.location&&<p>{p.location}</p>}{p.hours&&<p class="pro-hours">{p.hours}</p>}{cta&&<a class="pro-button" href={cta}>{p.bookingUrl?p.bookingLabel:'Contact the practice'} ↗</a>}</aside></section><section class="contour-treatments"><h2>Treatments & consultations</h2><ServiceMenu services={p.services}/></section><section class="contour-profile"><h2>People & practice</h2><div>{p.credentials.length>0&&<ul>{p.credentials.map(c=><li>{c}</li>)}</ul>}<a class="pro-link" href={aboutHref}>Meet the practitioner ↗</a></div></section><PracticeNotes {posts} {postsHref}/></section>
