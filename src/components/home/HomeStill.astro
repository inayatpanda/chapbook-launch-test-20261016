---
import {site} from '../../lib/site';
import {professionalDetails,contactHref} from '../../lib/professional.mjs';
import {withBase} from '../../lib/withBase';
import ServiceMenu from '../professional/ServiceMenu.astro';
import PracticeNotes from '../professional/PracticeNotes.astro';
const p=professionalDetails((site as any).professional);
const {name,masthead,tagline,posts,postsHref,aboutHref}=Astro.props;
const cta=p.bookingUrl?withBase('/appointments/'):contactHref(p);
---
<section class="pro-site still"><section class="still-opening"><p class="pro-kicker">{p.eyebrow||name}</p><h1>{p.heading||masthead}</h1><p class="pro-intro">{p.intro||tagline}</p>{cta&&<a class="pro-button" href={cta}>{p.bookingUrl?p.bookingLabel:'Get in touch'} ↗</a>}</section>{p.services.length>0&&<section class="still-sessions" aria-label="Sessions">{p.services.map((s,i)=><article><span class="still-index">{String(i+1).padStart(2,'0')}</span><h2>{s.name}</h2><p>{s.description}</p><p class="pro-price">{[s.duration,s.price].filter(Boolean).join(' · ')}</p>{s.bookingUrl&&<a class="pro-link" href={s.bookingUrl}>Book this session ↗</a>}</article>)}</section>}<section class="still-details"><div><h2>A little about<br/>the practice.</h2><a class="pro-link" href={aboutHref}>Read more ↗</a></div><div>{p.credentials.map(c=><p>{c}</p>)}{p.location&&<p>{p.location}</p>}{p.hours&&<p class="pro-hours">{p.hours}</p>}</div></section><PracticeNotes {posts} {postsHref}/></section>
