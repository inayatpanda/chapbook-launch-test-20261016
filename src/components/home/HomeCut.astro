---
import {site} from '../../lib/site';
import {professionalDetails,contactHref} from '../../lib/professional.mjs';
import {withBase} from '../../lib/withBase';
import ServiceMenu from '../professional/ServiceMenu.astro';
import PracticeNotes from '../professional/PracticeNotes.astro';
const p=professionalDetails((site as any).professional);
const {name,masthead,tagline,posts,postsHref,aboutHref}=Astro.props;
const cta=p.bookingUrl?withBase('/appointments/'):contactHref(p);
---
<section class="pro-site cut"><section class="cut-opening"><div class="cut-rail"><p class="pro-kicker">{p.eyebrow||name}</p>{p.location&&<span>{p.location}</span>}</div><h1>{p.heading||masthead}</h1><div class="cut-intro"><p class="pro-intro">{p.intro||tagline}</p>{cta&&<a class="pro-button" href={cta}>{p.bookingUrl?p.bookingLabel:'Say hello'} ↗</a>}</div></section><div class="cut-body"><section><h2>The menu</h2><ServiceMenu services={p.services}/></section><aside><h2>Find your chair.</h2>{p.hours&&<p class="pro-hours">{p.hours}</p>}{p.location&&<p>{p.location}</p>}<a class="pro-link" href={aboutHref}>Meet the team ↗</a>{p.credentials.map(c=><p>{c}</p>)}</aside></div><PracticeNotes {posts} {postsHref}/></section>
