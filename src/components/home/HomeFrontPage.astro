---
// ARCHETYPE · frontpage — broadsheet.
// A newspaper FRONT PAGE: a towering Fraunces nameplate over a dateline double-rule; a
// lead story set across two ruled columns (run-in heads, drop cap); and an "In this
// edition" sidebar of secondary heads. Swiss-modern 12-col discipline, hairline rules.
import {withBase} from '../../lib/withBase';
import type { HomeProps } from '../../lib/home';
import { fmtDate, fmtDateLong, pad2 } from '../../lib/home';

const { posts, masthead, tagline, postsHref, postsTitle } = Astro.props as HomeProps;
const lead = posts[0];
const briefs = posts.slice(1, 4);
const edition = posts.slice(4, 10);
const editionDate = lead ? fmtDateLong(lead.date) : '';
---
<section class="fp">
  <div class="container">
    <header class="fp-nameplate">
      <div class="fp-side">Vol. MMXXVI · No. {pad2(posts.length)}</div>
      <a class="fp-masthead" href={withBase('/')}>{masthead}</a>
      <div class="fp-side fp-side-r">{editionDate}</div>
    </header>
    <div class="fp-strap"><span>{tagline}</span></div>

    {lead && (
      <div class="fp-grid">
        <article class="fp-lead">
          {lead.topic && <p class="fp-kicker" style={`--c:${lead.topic.color}`}>{lead.topic.name}</p>}
          <h2 class="fp-lead-title"><a href={lead.href}>{lead.title}</a></h2>
          <p class="fp-standfirst">{lead.description}</p>
          <div class="fp-columns">
            {briefs.map((p, i) => (
              <p class={`fp-brief${i === 0 ? ' fp-brief-lead' : ''}`}>
                <a href={p.href}><strong>{p.title}. </strong></a>{p.description}
                <a class="fp-more" href={p.href}> Continued →</a>
              </p>
            ))}
          </div>
        </article>

        <aside class="fp-edition">
          <h3 class="fp-edition-head">In this edition</h3>
          <ol class="fp-edition-list">
            {edition.map((p, i) => (
              <li>
                <a href={p.href}>
                  <span class="fp-ed-num">{pad2(i + 1)}</span>
                  <span class="fp-ed-body">
                    <span class="fp-ed-title">{p.title}</span>
                    <span class="fp-ed-meta">{p.topic ? p.topic.name + ' · ' : ''}{fmtDate(p.date)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
          <a class="fp-all" href={postsHref}>Read the full {postsTitle.toLowerCase()} →</a>
        </aside>
      </div>
    )}
  </div>
</section>

<style>
  .fp { padding-block: clamp(1.4rem, 3vw, 2.6rem) 4rem; }
  .container { width: min(1120px, 100% - 2.5rem); }

  .fp-nameplate {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 1rem;
    padding-bottom: 0.5rem;
  }
  .fp-side { font-family: var(--font-display); font-size: 0.76rem; font-weight: 600; color: var(--ink-dim); letter-spacing: 0.02em; padding-bottom: 0.5rem; }
  .fp-side-r { text-align: right; font-style: italic; }
  .fp-masthead {
    font-family: var(--font-display); font-weight: 900; text-align: center;
    font-size: clamp(2.6rem, 9vw, 6rem); line-height: 0.9; letter-spacing: -0.02em;
    color: var(--ink); cursor: pointer;
  }
  .fp-strap {
    border-top: 3px solid var(--ink); border-bottom: 1px solid var(--ink);
    padding: 0.4rem 0; text-align: center; margin-bottom: 1.6rem;
  }
  .fp-strap span { font-family: var(--font-body); font-style: italic; font-size: clamp(0.92rem, 1.6vw, 1.1rem); color: var(--ink-dim); letter-spacing: 0.02em; }

  .fp-grid { display: grid; grid-template-columns: 1fr 20rem; gap: 0 2.2rem; }
  .fp-lead { border-right: 1px solid var(--line-strong); padding-right: 2.2rem; }
  .fp-kicker { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.72rem; color: var(--c, var(--accent)); }
  .fp-lead-title { margin: 0.35rem 0 0.6rem; }
  .fp-lead-title a { font-family: var(--font-display); font-weight: 900; letter-spacing: -0.02em; line-height: 0.98; font-size: clamp(2rem, 4.6vw, 3.4rem); color: var(--ink); cursor: pointer; }
  .fp-lead-title a:hover { color: var(--accent); }
  .fp-standfirst { font-family: var(--font-body); font-style: italic; font-size: 1.18rem; line-height: 1.45; color: var(--ink-dim); max-width: 46ch; padding-bottom: 1rem; margin-bottom: 1rem; border-bottom: 1px solid var(--line-strong); }
  .fp-columns { columns: 2; column-gap: 1.8rem; column-rule: 1px solid var(--line-strong); }
  .fp-brief { font-family: var(--font-body); font-size: 1rem; line-height: 1.55; color: var(--ink-dim); margin-bottom: 0.9rem; break-inside: avoid; }
  .fp-brief a { color: inherit; }
  .fp-brief strong { color: var(--ink); font-weight: 700; }
  .fp-brief a:hover strong { color: var(--accent); }
  .fp-brief-lead::first-letter { float: left; font-family: var(--font-display); font-weight: 900; font-size: 3.2em; line-height: 0.72; padding: 0.04em 0.08em 0 0; color: var(--accent); }
  .fp-more { color: var(--accent); font-style: italic; white-space: nowrap; }

  .fp-edition { align-self: start; }
  .fp-edition-head { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.92rem; padding-bottom: 0.4rem; border-bottom: 3px solid var(--ink); margin-bottom: 0.3rem; }
  .fp-edition-list { list-style: none; margin: 0; padding: 0; }
  .fp-edition-list li { border-bottom: 1px solid var(--line-strong); }
  .fp-edition-list a { display: grid; grid-template-columns: 1.7rem 1fr; gap: 0.7rem; padding: 0.7rem 0; cursor: pointer; }
  .fp-ed-num { font-family: var(--font-display); font-weight: 900; font-size: 1.1rem; color: var(--accent); font-variant-numeric: tabular-nums; }
  .fp-ed-title { display: block; font-family: var(--font-display); font-weight: 700; font-size: 1.02rem; line-height: 1.15; color: var(--ink); }
  .fp-edition-list a:hover .fp-ed-title { color: var(--accent); }
  .fp-ed-meta { display: block; margin-top: 0.2rem; font-family: var(--font-display); font-size: 0.72rem; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.03em; }
  .fp-all { display: inline-block; margin-top: 0.9rem; font-family: var(--font-display); font-weight: 700; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.02em; color: var(--accent); cursor: pointer; }
  .fp-all:hover { text-decoration: underline; }

  @media (max-width: 820px) {
    .fp-grid { grid-template-columns: 1fr; gap: 1.6rem; }
    .fp-lead { border-right: 0; padding-right: 0; border-bottom: 3px double var(--ink); padding-bottom: 1.4rem; }
  }
  @media (max-width: 560px) {
    .fp-nameplate { grid-template-columns: 1fr; text-align: center; }
    .fp-side, .fp-side-r { text-align: center; padding-bottom: 0; font-size: 0.7rem; }
    .fp-columns { columns: 1; }
  }
</style>
