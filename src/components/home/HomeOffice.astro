---
import {site} from '../../lib/site';
import {professionalDetails,contactHref} from '../../lib/professional.mjs';
import {withBase} from '../../lib/withBase';
import ServiceMenu from '../professional/ServiceMenu.astro';
import PracticeNotes from '../professional/PracticeNotes.astro';
const p=professionalDetails((site as any).professional);
const {name,masthead,tagline,posts,postsHref,aboutHref}=Astro.props;
const cta=p.bookingUrl?withBase('/appointments/'):contactHref(p);
---
<section class="pro-site office"><section class="office-opening"><div><p class="pro-kicker">{p.eyebrow||name}</p><h1>{p.heading||masthead}</h1></div><div class="office-brief"><p class="pro-intro">{p.intro||tagline}</p>{cta&&<a class="pro-button" href={cta}>{p.bookingUrl?p.bookingLabel:'Discuss a project'} ↗</a>}{p.location&&<p>{p.location}</p>}</div></section><section class="office-services"><aside><p class="pro-kicker">Scope of work</p><h2>How I can help.</h2></aside><ServiceMenu services={p.services}/></section><section class="office-profile"><span class="pro-kicker">Background</span>{p.credentials.map(c=><p>{c}</p>)}<a class="pro-link" href={aboutHref}>Experience & approach ↗</a></section><PracticeNotes {posts} {postsHref}/></section>
