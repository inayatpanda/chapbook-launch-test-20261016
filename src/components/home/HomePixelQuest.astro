---
// ARCHETYPE · pixel-quest — pixel.
// A COSY RETRO-HANDHELD screen in soft daylight pastels (game-boy greens). A chunky
// fake-pixel wordmark (layered CSS text-shadow — no pixel web font), tiny 8-bit SVG
// sprites, and posts as QUEST cards: a "QUEST 01" tag, title, short desc, an XP-bar
// segmented strip that doubles as a reading-length indicator, and a pixel sprite.
// LIGHT + pastel + cosy — deliberately distinct from a dark neon arcade CRT.
import type { HomeProps } from '../../lib/home';
import { fmtDate, pad2 } from '../../lib/home';

const { posts, topics, masthead, tagline, postsHref, postsTitle, topicsLabel } =
  Astro.props as HomeProps;
const SEG = 5;
const quests = posts.map((p, i) => ({
  post: p,
  qn: pad2(i + 1),
  filled: Math.max(1, Math.min(SEG, Math.round(p.readMins / 2))),
}));
const topicList = topics.filter((t) => t.count > 0);
---
<section class="pq">
  <div class="pq-wrap">
    <div class="pq-device">
      <div class="pq-screen">
        <div class="pq-screen-top">
          <span class="pq-hp" aria-hidden="true">
            <svg viewBox="0 0 11 10" width="18" height="16" shape-rendering="crispEdges"><path d="M2 0h2v1h1v1h1V1h2v1h1v3h-1v1h-1v1h-1v1h-1v1H4V8H3V7H2V6H1V5H0V2h1V1h1z"/></svg>
            <svg viewBox="0 0 8 8" width="15" height="15" shape-rendering="crispEdges"><path d="M3 0h2v1h1v1h1v1h1v2H7v1H6v1H5v1H3V7H2V6H1V5H0V3h1V2h1V1h1z"/></svg>
          </span>
          <span class="pq-power">POWER</span>
        </div>
        <p class="pq-eyebrow">{postsTitle} · save file</p>
        <h1 class="pq-brand">{masthead}</h1>
        <p class="pq-tagline">{tagline}</p>
        <a class="pq-start" href={postsHref}>
          <span class="pq-caret" aria-hidden="true">&#9654;</span> CONTINUE
        </a>
      </div>
    </div>

    <div class="pq-quests">
      {quests.map(({ post: p, qn, filled }) => (
        <a class="pq-card" href={p.href} style={`--card-accent:${p.topic?.color || p.accent}`}>
          <div class="pq-card-top">
            <span class="pq-tag">QUEST {qn}</span>
            <span class="pq-sprite" aria-hidden="true">
              <svg viewBox="0 0 8 8" width="26" height="26" shape-rendering="crispEdges">
                <rect x="3" y="1" width="2" height="1"/>
                <rect x="2" y="2" width="4" height="1"/>
                <rect x="1" y="3" width="6" height="2"/>
                <rect x="2" y="5" width="4" height="1"/>
                <rect x="3" y="6" width="2" height="1"/>
                <rect x="2" y="2" width="1" height="1" class="pq-sprite-hi"/>
              </svg>
            </span>
          </div>
          {p.topic && <span class="pq-cat">{p.topic.name}</span>}
          <h2 class="pq-title">{p.title}</h2>
          <p class="pq-desc">{p.description}</p>
          <div class="pq-xp" role="img" aria-label={`Reading length: ${p.readMins} minutes`}>
            {Array.from({ length: SEG }).map((_, s) => (
              <span class={s < filled ? 'pq-seg pq-seg-on' : 'pq-seg'}></span>
            ))}
          </div>
          <span class="pq-meta">
            <span class="pq-xp-label">XP</span>
            <time datetime={p.date.toISOString()}>{fmtDate(p.date)}</time>
            <span class="pq-dot" aria-hidden="true">·</span>
            <span>{p.readMins} min</span>
          </span>
        </a>
      ))}
    </div>

    <footer class="pq-party">
      <p class="pq-party-label">{topicsLabel} · areas unlocked</p>
      <ul>
        {topicList.map((t) => (
          <li><a href={t.href} style={`--c:${t.color}`}><span class="pq-chip-icon" aria-hidden="true"></span>{t.name}<span class="pq-chip-count">{t.count}</span></a></li>
        ))}
      </ul>
    </footer>
  </div>
</section>

<style>
  .pq {
    --mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    background: var(--bg-0);
    padding-block: clamp(1.4rem, 4vw, 2.8rem) 4rem;
  }
  .pq-wrap { width: min(1080px, 100% - 2rem); margin-inline: auto; }

  /* ---- handheld device / screen ---- */
  .pq-device {
    background: var(--bg-3); border: 3px solid var(--ink); border-radius: 10px;
    padding: clamp(0.7rem, 2vw, 1.1rem); box-shadow: 5px 6px 0 rgba(43, 47, 36, 0.18);
    margin-bottom: clamp(1.6rem, 4vw, 2.4rem);
  }
  .pq-screen {
    background: var(--bg-1); border: 3px solid var(--ink); border-radius: 6px;
    padding: clamp(1.2rem, 4vw, 2.2rem) clamp(1.1rem, 3.5vw, 2rem);
    box-shadow: inset 0 0 0 2px rgba(90, 158, 63, 0.18);
  }
  .pq-screen-top {
    display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
    margin-bottom: 0.9rem; padding-bottom: 0.7rem; border-bottom: 2px dashed var(--line-strong);
  }
  .pq-hp { display: inline-flex; align-items: center; gap: 0.4rem; }
  .pq-hp svg:first-child { fill: var(--pink); }
  .pq-hp svg:last-child { fill: var(--amber); }
  .pq-power { font-family: var(--mono); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.18em; color: var(--ink-faint); }
  .pq-eyebrow { font-family: var(--mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .pq-brand {
    margin: 0.5rem 0 0.1rem;
    font-family: var(--mono); font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; line-height: 1.05; font-size: clamp(1.9rem, 6vw, 3.2rem);
    color: var(--accent); word-break: break-word;
    /* fake pixel: hard stepped extrude in ink — no pixel web font */
    text-shadow: 1px 1px 0 var(--ink), 2px 2px 0 var(--ink), 3px 3px 0 var(--ink), 4px 4px 0 rgba(43, 47, 36, 0.28);
  }
  .pq-tagline { margin-top: 0.9rem; font-family: var(--font-body); font-size: 1.02rem; line-height: 1.55; color: var(--ink-dim); max-width: 54ch; }
  .pq-start {
    display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.1rem; cursor: pointer;
    font-family: var(--mono); font-weight: 700; font-size: 0.9rem; letter-spacing: 0.12em;
    color: #fff; background: var(--accent); border: 2px solid var(--ink); border-radius: 4px;
    padding: 0.62rem 1.1rem; box-shadow: 3px 3px 0 var(--ink);
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }
  .pq-start:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 var(--ink); }
  .pq-caret { color: var(--amber); font-size: 0.8em; }

  /* ---- quest cards ---- */
  .pq-quests {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 258px), 1fr));
    gap: clamp(1rem, 2.5vw, 1.4rem);
  }
  .pq-card {
    display: flex; flex-direction: column; min-height: 210px; cursor: pointer;
    background: var(--bg-1); border: 2px solid var(--ink); border-radius: var(--radius);
    padding: 1.1rem 1.1rem 1rem; box-shadow: 3px 3px 0 rgba(43, 47, 36, 0.16);
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }
  .pq-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 color-mix(in srgb, var(--card-accent, var(--accent)) 60%, var(--ink));
    border-color: color-mix(in srgb, var(--card-accent, var(--accent)) 55%, var(--ink));
  }
  .pq-card-top { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; }
  .pq-tag {
    font-family: var(--mono); font-weight: 700; font-size: 0.66rem; letter-spacing: 0.12em;
    color: #fff; background: var(--ink); padding: 0.24rem 0.5rem; border-radius: 3px;
  }
  .pq-sprite { color: var(--card-accent, var(--accent)); line-height: 0; }
  .pq-sprite svg { fill: currentColor; }
  .pq-sprite-hi { fill: #fff; }
  .pq-cat { margin-top: 0.7rem; font-family: var(--mono); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.64rem; color: color-mix(in srgb, var(--card-accent, var(--accent)) 70%, var(--ink)); }
  .pq-title { margin: 0.35rem 0 0; font-family: var(--font-display); font-weight: 600; font-size: 1.14rem; line-height: 1.24; color: var(--ink); }
  .pq-desc {
    margin: 0.45rem 0 auto; font-family: var(--font-body); font-size: 0.94rem; line-height: 1.5; color: var(--ink-dim);
    overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  }
  .pq-xp { display: flex; gap: 3px; margin-top: 0.9rem; }
  .pq-seg { flex: 1; height: 10px; border: 2px solid var(--ink); border-radius: 2px; background: var(--bg-3); }
  .pq-seg-on { background: var(--card-accent, var(--accent)); }
  .pq-meta {
    display: flex; align-items: center; gap: 0.4rem; margin-top: 0.6rem;
    font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 0.72rem; color: var(--ink-faint);
  }
  .pq-xp-label { font-weight: 700; letter-spacing: 0.08em; color: color-mix(in srgb, var(--card-accent, var(--accent)) 70%, var(--ink)); }
  .pq-dot { color: var(--card-accent, var(--accent)); }

  /* ---- party / areas footer ---- */
  .pq-party { margin-top: clamp(1.8rem, 4vw, 2.6rem); padding-top: 1.3rem; border-top: 2px dashed var(--line-strong); }
  .pq-party-label { font-family: var(--mono); font-weight: 700; font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 0.8rem; }
  .pq-party ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.55rem 0.7rem; }
  .pq-party a {
    display: inline-flex; align-items: center; gap: 0.45rem; cursor: pointer;
    font-family: var(--mono); font-size: 0.82rem; color: var(--ink-dim);
    background: var(--bg-1); border: 2px solid var(--ink); border-radius: 4px; padding: 0.32rem 0.6rem;
    box-shadow: 2px 2px 0 rgba(43, 47, 36, 0.14); transition: transform 0.16s ease, box-shadow 0.16s ease, color 0.16s ease;
  }
  .pq-party a:hover { transform: translate(-1px, -1px); box-shadow: 3px 3px 0 rgba(43, 47, 36, 0.2); color: var(--ink); }
  .pq-chip-icon { width: 9px; height: 9px; background: var(--c, var(--accent)); border: 1.5px solid var(--ink); flex: none; }
  .pq-chip-count { font-variant-numeric: tabular-nums; font-size: 0.72rem; color: var(--ink-faint); }

  @media (prefers-reduced-motion: no-preference) {
    .pq-caret { animation: pq-blink 1.1s steps(1) infinite; }
    @keyframes pq-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.2; } }
  }
</style>
