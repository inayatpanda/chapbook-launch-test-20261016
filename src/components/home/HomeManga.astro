---
// ARCHETYPE · manga — comic.
// A MANGA / GRAPHIC-NOVEL front page: a screen-tone HALFTONE ground, a dynamic
// PANEL-BORDER grid (irregular spanning cells, thick black ink borders), a big FEATURED
// panel (latest post) with an impact burst behind the title (jagged star via clip-path),
// and post titles set in SPEECH-BUBBLE shapes. Red + blue on halftone cream.
import type { HomeProps } from '../../lib/home';
import { fmtDate, pad2 } from '../../lib/home';

const { posts, topics, masthead, tagline, postsHref, postsTitle, topicsLabel } =
  Astro.props as HomeProps;
const lead = posts[0];
const panels = posts.slice(1);
const topicList = topics.filter((t) => t.count > 0);
---
<section class="mg">
  <div class="mg-wrap">
    <header class="mg-top">
      <p class="mg-issue">{postsTitle} · issue №{pad2(posts.length)}</p>
      <h1 class="mg-name">{masthead}</h1>
      <p class="mg-tagline">{tagline}</p>
    </header>

    <div class="mg-grid">
      {lead && (
        <article class="mg-panel mg-panel--lead" style={`--c:${lead.topic?.color || lead.accent}`}>
          <span class="mg-flash" aria-hidden="true">LATEST</span>
          <span class="mg-burst" aria-hidden="true"></span>
          {lead.topic && <span class="mg-kicker">{lead.topic.name}</span>}
          <a class="mg-bubble mg-bubble--lead" href={lead.href}>
            <span class="mg-bubble-text">{lead.title}</span>
          </a>
          <p class="mg-lead-desc">{lead.description}</p>
          <span class="mg-meta">
            <time datetime={lead.date.toISOString()}>{fmtDate(lead.date)}</time>
            <span class="mg-dot" aria-hidden="true">●</span>
            <span>{lead.readMins} min</span>
          </span>
        </article>
      )}

      {panels.map((p, i) => (
        <article class={`mg-panel${i === 0 ? ' mg-panel--wide' : ''}`} style={`--c:${p.topic?.color || p.accent}`}>
          <span class="mg-no" aria-hidden="true">{pad2(i + 2)}</span>
          {p.topic && <span class="mg-kicker">{p.topic.name}</span>}
          <a class="mg-bubble" href={p.href}>
            <span class="mg-bubble-text">{p.title}</span>
          </a>
          <span class="mg-meta">
            <time datetime={p.date.toISOString()}>{fmtDate(p.date)}</time>
            <span class="mg-dot" aria-hidden="true">●</span>
            <span>{p.readMins} min</span>
          </span>
        </article>
      ))}
    </div>

    <footer class="mg-foot">
      <div class="mg-tags">
        <p class="mg-tags-label">{topicsLabel}</p>
        <ul>
          {topicList.map((t) => (
            <li><a href={t.href} style={`--c:${t.color}`}>{t.name}<span class="mg-tag-count">{t.count}</span></a></li>
          ))}
        </ul>
      </div>
      <a class="mg-all" href={postsHref}>
        Read all {postsTitle.toLowerCase()}
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </footer>
  </div>
</section>

<style>
  .mg {
    /* screen-tone halftone ground */
    background-color: var(--bg-0);
    background-image: radial-gradient(circle, rgba(20, 17, 12, 0.11) 1.2px, transparent 1.7px);
    background-size: 9px 9px;
    padding-block: clamp(1.4rem, 4vw, 2.6rem) 4rem;
  }
  .mg-wrap { width: min(1140px, 100% - 2rem); margin-inline: auto; }

  /* ---- top nameplate ---- */
  .mg-top { margin-bottom: clamp(1.4rem, 3.5vw, 2rem); }
  .mg-issue { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.74rem; color: var(--accent); }
  .mg-name {
    font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.005em;
    line-height: 0.92; font-size: clamp(2.4rem, 8vw, 4.6rem); color: var(--ink); margin: 0.2rem 0 0.4rem;
    -webkit-text-stroke: 1px var(--ink); text-shadow: 3px 3px 0 var(--amber);
  }
  .mg-tagline { font-family: var(--font-body); font-size: 1.05rem; line-height: 1.5; color: var(--ink-dim); max-width: 56ch; }

  /* ---- panel grid ---- */
  .mg-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .mg-panel {
    position: relative; display: flex; flex-direction: column; min-height: 150px; overflow: hidden;
    background: var(--bg-1); border: 3px solid var(--ink); border-radius: var(--radius);
    padding: 1.1rem 1.1rem 1rem; box-shadow: 6px 6px 0 var(--ink);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .mg-panel:hover { transform: translate(-2px, -2px); box-shadow: 9px 9px 0 var(--ink); }
  .mg-panel--lead {
    min-height: 300px; justify-content: center; align-items: flex-start;
    background:
      radial-gradient(circle, rgba(20, 17, 12, 0.08) 1.1px, transparent 1.6px) 0 0 / 8px 8px,
      linear-gradient(150deg, color-mix(in srgb, var(--c) 16%, var(--bg-1)), var(--bg-1) 60%);
  }

  .mg-no {
    position: absolute; top: 0.5rem; right: 0.7rem; font-family: var(--font-display); font-weight: 700;
    font-size: 0.9rem; color: var(--line-strong); opacity: 0.35; font-variant-numeric: tabular-nums;
  }
  .mg-flash {
    position: absolute; top: 0.8rem; right: 0.8rem; z-index: 3;
    font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    font-size: 0.66rem; color: #fff; background: var(--accent);
    padding: 0.22rem 0.5rem; border: 2px solid var(--ink); transform: rotate(4deg);
  }
  /* impact burst behind the lead title */
  .mg-burst {
    position: absolute; z-index: 0; left: -6%; top: 34%; width: 78%; height: 46%;
    background: var(--amber);
    clip-path: polygon(50% 0, 61% 22%, 84% 12%, 74% 36%, 100% 42%, 76% 56%, 92% 82%, 63% 70%, 55% 100%, 44% 71%, 12% 84%, 26% 56%, 2% 44%, 26% 36%, 14% 12%, 39% 22%);
    opacity: 0.9;
  }
  .mg-kicker {
    position: relative; z-index: 2; font-family: var(--font-display); font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; font-size: 0.66rem; color: var(--accent); margin-bottom: 0.5rem;
  }

  /* speech-bubble titles */
  .mg-bubble {
    position: relative; z-index: 2; display: inline-block; align-self: flex-start; cursor: pointer;
    background: #fff; border: 3px solid var(--ink); border-radius: 16px;
    padding: 0.5rem 0.85rem; margin-bottom: 0.7rem; max-width: 100%;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .mg-bubble::after {
    content: ""; position: absolute; left: 1.6rem; bottom: -13px;
    width: 18px; height: 15px; background: #fff;
    border-right: 3px solid var(--ink); border-bottom: 3px solid var(--ink);
    transform: skewX(-16deg); border-radius: 0 0 5px 0;
  }
  .mg-bubble-text {
    font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.005em;
    line-height: 1.08; font-size: 1.1rem; color: var(--ink);
  }
  .mg-bubble:hover { transform: rotate(-1deg) scale(1.01); background: var(--amber); }
  .mg-bubble--lead { padding: 0.7rem 1.1rem; }
  .mg-bubble--lead .mg-bubble-text { font-size: clamp(1.5rem, 3.4vw, 2.4rem); }

  .mg-lead-desc {
    position: relative; z-index: 2; font-family: var(--font-body); font-size: 1rem; line-height: 1.5;
    color: var(--ink-dim); max-width: 48ch; margin-top: 0.2rem;
    overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
  }
  .mg-meta {
    position: relative; z-index: 2; display: flex; align-items: center; gap: 0.45rem; margin-top: auto; padding-top: 0.7rem;
    font-family: var(--font-display); font-weight: 600; font-variant-numeric: tabular-nums;
    font-size: 0.76rem; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.04em;
  }
  .mg-dot { color: var(--c, var(--accent)); font-size: 0.6em; }

  /* ---- footer ---- */
  .mg-foot {
    display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between;
    gap: 1.2rem 2rem; margin-top: clamp(1.8rem, 4vw, 2.6rem); padding-top: 1.2rem;
    border-top: 3px solid var(--ink);
  }
  .mg-tags-label { font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.72rem; color: var(--ink-faint); margin-bottom: 0.7rem; }
  .mg-tags ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 0.6rem; }
  .mg-tags a {
    display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer;
    font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; font-size: 0.76rem;
    color: var(--ink); background: #fff; border: 2px solid var(--ink); border-radius: 6px; padding: 0.3rem 0.55rem;
    box-shadow: 2px 2px 0 var(--ink); transition: transform 0.16s ease, box-shadow 0.16s ease, background 0.16s ease;
  }
  .mg-tags a:hover { transform: translate(-1px, -1px); box-shadow: 3px 3px 0 var(--ink); background: var(--amber); }
  .mg-tag-count { font-variant-numeric: tabular-nums; font-size: 0.72rem; color: var(--c, var(--accent)); }
  .mg-all {
    display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer;
    font-family: var(--font-display); font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; font-size: 0.9rem;
    color: #fff; background: var(--accent); border: 3px solid var(--ink); border-radius: 8px; padding: 0.6rem 1.1rem;
    box-shadow: 4px 4px 0 var(--ink); transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .mg-all:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--ink); }

  @media (min-width: 560px) {
    .mg-grid { grid-template-columns: repeat(2, 1fr); }
    .mg-panel--lead { grid-column: span 2; }
  }
  @media (min-width: 900px) {
    .mg-grid { grid-template-columns: repeat(4, 1fr); grid-auto-rows: 1fr; }
    .mg-panel--lead { grid-column: span 2; grid-row: span 2; }
    .mg-panel--wide { grid-column: span 2; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .mg-flash { animation: mg-wobble 2.8s ease-in-out infinite; }
    @keyframes mg-wobble { 0%, 100% { transform: rotate(4deg); } 50% { transform: rotate(-2deg); } }
  }
</style>
