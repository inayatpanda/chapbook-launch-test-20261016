---
import {site} from '../../lib/site';
import {professionalDetails,contactHref} from '../../lib/professional.mjs';
import {withBase} from '../../lib/withBase';
import ServiceMenu from '../professional/ServiceMenu.astro';
import PracticeNotes from '../professional/PracticeNotes.astro';
const p=professionalDetails((site as any).professional);
const {name,masthead,tagline,posts,postsHref,aboutHref}=Astro.props;
const cta=p.bookingUrl?withBase('/appointments/'):contactHref(p);
---
<section class="pro-site portrait"><header class="portrait-name"><p class="pro-kicker">{p.eyebrow||'An introduction'}</p><h1>{p.heading||masthead}</h1>{p.location&&<span>{p.location}</span>}</header><div class="portrait-body"><aside><h2>{name}</h2><p class="pro-intro">{p.intro||tagline}</p>{cta&&<a class="pro-link" href={cta}>{p.bookingUrl?p.bookingLabel:'Say hello'} ↗</a>}{p.credentials.map(c=><p>{c}</p>)}<p><a href={aboutHref}>More about me ↗</a></p></aside><div>{p.services.length>0&&<section><h2>Selected work & services</h2><ServiceMenu services={p.services}/></section>}<PracticeNotes {posts} {postsHref}/></div></div></section>
