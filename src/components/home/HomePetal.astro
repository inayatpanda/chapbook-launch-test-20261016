---
import {site} from '../../lib/site';
import {professionalDetails,contactHref} from '../../lib/professional.mjs';
import {withBase} from '../../lib/withBase';
import ServiceMenu from '../professional/ServiceMenu.astro';
import PracticeNotes from '../professional/PracticeNotes.astro';
const p=professionalDetails((site as any).professional);
const {name,masthead,tagline,posts,postsHref,aboutHref}=Astro.props;
const cta=p.bookingUrl?withBase('/appointments/'):contactHref(p);
---
<section class="pro-site petal"><section class="petal-opening"><p class="pro-kicker">{p.eyebrow||name}</p><h1>{p.heading||masthead}</h1><p class="pro-intro">{p.intro||tagline}</p>{cta&&<a class="pro-link" href={cta}>{p.bookingUrl?p.bookingLabel:'Get in touch'} ↗</a>}<span class="petal-flower" aria-hidden="true">✳</span></section><section class="petal-menu"><div><p class="pro-kicker">Time for you</p><h2>The treatment<br/>menu.</h2>{p.location&&<p>{p.location}</p>}</div><ServiceMenu services={p.services}/></section><section class="petal-about"><h2>Meet your practitioner.</h2><div>{p.credentials.map(c=><p>{c}</p>)}<a class="pro-link" href={aboutHref}>Our approach ↗</a></div></section><PracticeNotes {posts} {postsHref}/></section>
