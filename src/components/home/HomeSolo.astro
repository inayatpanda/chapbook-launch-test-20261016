---
// ARCHETYPE · solo — Air (Kinfolk-calm landing).
// NO grid, NO wall. ONE latest post owns the first viewport. A tiny centred wordmark +
// one-line tagline sit at the top; then enormous whitespace; then the single latest post
// shown large and quiet — category kicker, an understated title with generous leading, an
// italic standfirst, a slim date · min meta line and a "Read" link. Everything else hides
// behind one barely-there "All {postsTitle} →" link and a faint single line of topic names.
// Muted near-white, soft-blue accent used sparingly. Reads as "one quiet feature, nothing more".
import {withBase} from '../../lib/withBase';
import type { HomeProps } from '../../lib/home';
import { fmtDateLong } from '../../lib/home';

const { posts, topics, masthead, tagline, postsHref, postsTitle } = Astro.props as HomeProps;
const feature = posts[0];
const strand = topics.filter((t) => t.count > 0);
---
<section class="solo">
  <div class="solo-inner">
    <header class="solo-brand">
      <a class="solo-mark" href={withBase('/')}>{masthead}</a>
      <p class="solo-tag">{tagline}</p>
    </header>

    <div class="solo-body">
      {feature ? (
        <article class="solo-feature">
          <p class="solo-eyebrow">Latest</p>
          {feature.topic && <p class="solo-kicker">{feature.topic.name}</p>}
          <h1 class="solo-title"><a href={feature.href}>{feature.title}</a></h1>
          {feature.description && <p class="solo-standfirst">{feature.description}</p>}
          <p class="solo-meta">
            <time datetime={feature.date.toISOString()}>{fmtDateLong(feature.date)}</time>
            <span class="solo-dot" aria-hidden="true">·</span>
            <span>{feature.readMins} min</span>
          </p>
          <a class="solo-read" href={feature.href}>
            <span>Read</span>
            <svg class="solo-arrow" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
          </a>
        </article>
      ) : (
        <p class="solo-empty">Nothing published yet.</p>
      )}
    </div>

    <footer class="solo-foot">
      <a class="solo-all" href={postsHref}>
        <span>All {postsTitle.toLowerCase()}</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
      </a>
      {strand.length > 0 && (
        <nav class="solo-strand" aria-label={postsTitle}>
          {strand.map((t) => <a href={t.href}>{t.name}</a>)}
        </nav>
      )}
    </footer>
  </div>
</section>

<style>
  .solo {
    min-height: calc(100svh - var(--header-h));
    display: flex;
    flex-direction: column;
  }
  .solo-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: min(720px, 100% - 3rem);
    margin-inline: auto;
    padding-block: clamp(1.8rem, 5vh, 3.4rem) clamp(1.6rem, 4vh, 2.8rem);
    text-align: center;
  }

  /* ---- top: tiny wordmark + one-line tagline ---- */
  .solo-brand { display: flex; flex-direction: column; align-items: center; gap: 0.55rem; }
  .solo-mark {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    color: var(--ink);
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .solo-mark:hover { color: var(--accent); }
  .solo-tag {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink-faint);
    max-width: 46ch;
  }

  /* ---- the enormous middle: the single feature, vertically centred in the air ---- */
  .solo-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding-block: clamp(2.5rem, 12vh, 7rem);
  }
  .solo-feature { max-width: 40rem; }

  .solo-eyebrow {
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 1.4rem;
  }
  .solo-kicker {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }
  .solo-title { margin: 0; }
  .solo-title a {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 5.2vw, 3.35rem);
    line-height: 1.14;
    letter-spacing: -0.022em;
    color: var(--ink);
    text-wrap: balance;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .solo-title a:hover { color: var(--accent); }
  .solo-standfirst {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.16rem;
    line-height: 1.62;
    color: var(--ink-dim);
    max-width: 40ch;
    margin: 1.2rem auto 0;
    text-wrap: pretty;
  }
  .solo-meta {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.55rem;
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--ink-faint);
  }
  .solo-dot { color: var(--line-strong); }

  .solo-read {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.9rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--accent);
    cursor: pointer;
    transition: gap 0.2s ease, opacity 0.2s ease;
  }
  .solo-read:hover { gap: 0.8rem; opacity: 0.82; }
  .solo-arrow { transition: transform 0.2s ease; }
  .solo-read:hover .solo-arrow { transform: translateX(2px); }

  .solo-empty { color: var(--ink-faint); font-family: var(--font-body); }

  /* ---- bottom: one faint archive link + a single hushed line of topics ---- */
  .solo-foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }
  .solo-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.88rem;
    color: var(--ink-dim);
    cursor: pointer;
    transition: color 0.2s ease, gap 0.2s ease;
  }
  .solo-all:hover { color: var(--accent); gap: 0.6rem; }
  .solo-strand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.35rem 0.9rem;
    max-width: 44rem;
  }
  .solo-strand a {
    position: relative;
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--ink-faint);
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .solo-strand a:not(:last-child)::after {
    content: "·";
    position: absolute;
    right: -0.55rem;
    color: var(--line-strong);
  }
  .solo-strand a:hover { color: var(--ink); }

  /* gentle rise of the feature; steady for reduced motion */
  @media (prefers-reduced-motion: no-preference) {
    .solo-feature { animation: solo-rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
    @keyframes solo-rise {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: none; }
    }
  }

  @media (max-width: 640px) {
    .solo-body { padding-block: clamp(2rem, 8vh, 4rem); }
    .solo-eyebrow { margin-bottom: 1rem; }
  }
</style>
